  "supervisor_pd": {
   "rationale": "Parent of script_pd: the only holder of script_pd's TCB capability (restart/stop of that one PD). Timer client, one channel to http_pd, a read-only page from http_pd and a one-way write page to http_pd. Runs just above script_pd so a hung script cannot starve it.",
   "signal": [
    "http_pd"
   ],
   "send": [
    "monitor"
   ],
   "call": [
    "timer_driver"
   ],
   "irq": [],
   "ioport": [],
   "other_caps": [
    "TCB:tcb_script_pd"
   ],
   "maps": {
    "shm_http_sup": "r",
    "shm_sup_http": "rw"
   },
   "priority": 93,
   "optional": true
  },
  "qedos_press_pd": {
   "signal": [
    "http_pd",
    "policy_pd"
   ],
   "send": [
    "monitor"
   ],
   "call": [],
   "irq": [],
   "ioport": [],
   "maps": {
    "shm_policy_press": "rw",
    "shm_press_http": "rw"
   },
   "other_caps": [],
   "priority": 92,
   "rationale": "Serves read-only static content from a signed release bundle (GET/HEAD only). Two shared regions and two notification channels (policy_pd request in, http_pd response out). No secrets, no hardware, no children, no TCB cap over it (unlike script_pd, it has no supervisor parent -- documented gap, not an oversight: it runs no untrusted code, so the fault-containment need that motivated script_pd's supervisor does not apply the same way). Its content bundle is embedded as read-only .rodata in its own ELF, not a mapped shared region.",
   "interface_pds": [
    "http_pd",
    "policy_pd",
    "monitor"
   ],
   "optional": true
  }
 },
