runtime = qs-wasm/1
module = kv-counter
version = 1
allow = kv_get
allow = kv_put
allow = resp_status
allow = resp_content_type
allow = resp_write
kv_read = a/
kv_write = a/
max_memory_bytes = 65536
max_fuel = 20000
max_stack_depth = 4
max_request_bytes = 1024
max_response_bytes = 1024
max_host_calls = 32
max_exec_us = 20000
