# Rust build outputs
/target/
/sel4/rust_pds/target/

# Local toolchains & heavy third-party builds
/tools/conda/
/tools/qemu/
/third_party/*
!/third_party/openssl-3.6.1.tar.gz.sha256

# Build artifacts (keep formal verification & benchmark evidence)
/build/*
!/build/kani/
!/build/perf/
!/build/script/
!/build/sel4/
/build/sel4/*
!/build/sel4/proofgate.system
!/build/sel4/report.txt
!/build/sel4/viper/
!/build/sel4/loader.img.gz
!/build/sel4/sel4_32.elf.gz

# Compiled objects and test runners in sel4/libc_shim
/sel4/libc_shim/*.o
/sel4/libc_shim/*.elf
/sel4/libc_shim/test_tls_shim_runner

# Python cache
__pycache__/
*.pyc
/examples/malicious/out/
/sel4/rust_script/target/
/sel4/rust_press/target/

# Real (non-dev) TLS material -- e.g. a Let's Encrypt cert/key for an actual public
# deployment -- must never be committed. config/dev/* (the dev self-signed cert/key)
# stays committed on purpose; config/local/* never does.
/config/local/
